# Copia este archivo como .env y rellena los valores. Nunca subas el .env a git.

# En Railway: ${{Postgres.DATABASE_URL}} (conexión interna)
DATABASE_URL="postgresql://usuario:contraseña@host:5432/base"

# Genera cada uno con: openssl rand -base64 32
JWT_SECRET=""
JOURNAL_ENCRYPTION_KEY=""

GROQ_API_KEY=""

# Opcionales (estos son los valores por defecto)
# GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_SAFETY_MODEL="openai/gpt-oss-safeguard-20b"
# GROQ_SAFETY_FALLBACK_MODEL="openai/gpt-oss-20b"
# CHAT_LIMIT_FREE=10
# CHAT_LIMIT_PREMIUM=30
# CHAT_MAX_MESSAGES_PER_CONVERSATION=40
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# CONSENT_VERSION="2026-10"

# Correo de confirmación de citas (Gmail: activa la verificación en 2 pasos y crea una «contraseña de aplicación»)
# MAIL_USER="nathaliemassiel28@gmail.com"
# MAIL_PASS="xxxx xxxx xxxx xxxx"
# MAIL_FROM_NAME="EspacioVital"
# MAIL_NOTIFY_TO="nathaliemassiel28@gmail.com"   # varios, separados por comas
# SITE_URL="https://espaciovitalpsic.site"

# Horas mínimas de anticipación para reservar una cita (por defecto 4)
# APPOINTMENT_BOOKING_MIN_HOURS=4

# CAPTCHA de la agenda pública (Cloudflare Turnstile → clave secreta). Si falta, no se exige.
# TURNSTILE_SECRET=""
