// Esquema de base de datos de Florece.
// Las tablas y columnas se guardan en snake_case (@@map / @map).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  USER
  PSYCHOLOGIST
  ADMIN
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum Plan {
  FREE
  PREMIUM
}

enum FocusArea {
  SELF_ESTEEM
  ANXIETY
  EMOTIONAL_REGULATION
  SELF_CARE
  RELATIONSHIPS
  SELF_KNOWLEDGE
}

enum ConsentType {
  TERMS
  PRIVACY
  SENSITIVE_DATA
  AI_PROCESSING
  COMMUNITY_RULES
}

enum AvatarSpecies {
  BEAR
  BUNNY
  FOX
  CAT
  CAPYBARA
}

enum ItemCategory {
  CLOTHING
  ACCESSORY
  FURNITURE
  PLANT
  BACKGROUND
  DECORATION
}

enum SeedReason {
  CHALLENGE
  PURCHASE
  BONUS
  ADJUSTMENT
  ACTIVITY
}

enum ActivityType {
  BREATHING
  MEDITATION
  BODY_SCAN
  GRATITUDE
  BUBBLES
  ZEN_GARDEN
  CONTENT
}

enum ContentKind {
  READING
  LINK
}

enum ChallengeCategory {
  SELF_KNOWLEDGE
  EMOTIONAL_SKILLS
  SELF_CARE
}

enum EvidenceType {
  TEXT
  AUDIO
  PHOTO
  INTERACTIVE
}

enum DailyChallengeStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum Emotion {
  JOY
  CALM
  GRATITUDE
  SADNESS
  ANXIETY
  ANGER
  FRUSTRATION
  TIREDNESS
  NEUTRAL
}

enum ChatMode {
  SUPPORT
  SELF_REGULATION
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum RiskLevel {
  NONE
  LOW
  MODERATE
  HIGH
  IMMINENT
}

enum RiskSource {
  CHAT
  JOURNAL
  COMMUNITY
  CALM_BUTTON
  CHALLENGE
  ROUTINE
}

enum PostStatus {
  VISIBLE
  PENDING_REVIEW
  HIDDEN
  REMOVED
}

enum ReactionType {
  HUG
  SUPPORT
  CELEBRATE
}

enum ReportReason {
  HARASSMENT
  SELF_HARM
  SPAM
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum SlotStatus {
  OPEN
  BOOKED
  BLOCKED
}

enum CareLinkStatus {
  ACTIVE
  ENDED
}

enum AppointmentSource {
  APP // desde la app Florece
  WEB // desde el sitio web del psicólogo, sin cuenta
}

enum AppointmentCanceller {
  PATIENT
  PSYCHOLOGIST
}

enum AppointmentStatus {
  REQUESTED // la persona pidió la cita; falta que el psicólogo la confirme
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentModality {
  VIDEO
  IN_PERSON
}

enum SubscriptionProvider {
  APPLE
  GOOGLE
  REVENUECAT
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  CANCELLED
  EXPIRED
}

// ─────────────────────────────────────────────
// Usuarios, autenticación y consentimientos
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash") // null si solo entra con Google/Apple
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  role            UserRole  @default(USER)
  birthDate       DateTime? @map("birth_date") @db.Date // para validar mayoría de edad
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  identities       AuthIdentity[]
  sessions         Session[]
  profile          Profile?
  consents         Consent[]
  avatar           Avatar? // la mascota que acompaña a la persona
  character        Character?
  items            UserItem[]
  seedTransactions SeedTransaction[]
  dailyChallenges  DailyChallenge[]
  journalEntries   JournalEntry[]
  moodLogs         MoodLog[]
  conversations    ChatConversation[]
  chatUsage        ChatUsage[]
  riskEvents       RiskEvent[]        @relation("RiskEventUser")
  reviewedRisks    RiskEvent[]        @relation("RiskEventReviewer")
  wellbeingPlan    WellbeingPlan?
  posts            Post[]
  reactions        PostReaction[]
  reportsMade      Report[]           @relation("ReportReporter")
  reportsResolved  Report[]           @relation("ReportResolver")
  psychologist     Psychologist?
  appointments     Appointment[]
  careLinks        CareLink[]         @relation("PatientCareLinks")
  routines         Routine[]          @relation("PatientRoutines")
  activityLogs     ActivityLog[]
  assignedContent  AssignedContent[]  @relation("PatientContent")
  sharedSummaries  SharedSummary[]
  subscriptions    Subscription[]

  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceName       String?   @map("device_name")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Profile {
  userId                String      @id @map("user_id") @db.Uuid
  displayName           String      @map("display_name")
  focusAreas            FocusArea[] @map("focus_areas")
  plan                  Plan        @default(FREE)
  premiumUntil          DateTime?   @map("premium_until") @db.Timestamptz(6)
  seedsBalance          Int         @default(0) @map("seeds_balance")
  waterBalance          Int         @default(0) @map("water_balance") // gotas para regar las plantas
  timezone              String      @default("America/Mexico_City")
  countryCode           String?     @map("country_code") @db.Char(2) // para mostrar recursos de crisis locales
  onboardingCompletedAt DateTime?   @map("onboarding_completed_at") @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Consent {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now()) @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime?   @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consents")
}

model Subscription {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  provider         SubscriptionProvider
  productId        String               @map("product_id")
  externalId       String               @unique @map("external_id")
  status           SubscriptionStatus
  currentPeriodEnd DateTime             @map("current_period_end") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────
// Avatar, jardín, tienda y semillas
// ─────────────────────────────────────────────

model Avatar {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @unique @map("user_id") @db.Uuid
  species   AvatarSpecies
  name      String
  color     String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avatars")
}

// Avatar humano de la persona (estilo Mii): piel, cara, cabello y ropa.
// El aspecto se guarda como JSON validado en src/character/character.constants.ts.
model Character {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  look      Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("characters")
}

model Item {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  name        String
  category    ItemCategory
  priceSeeds  Int          @map("price_seeds")
  premiumOnly Boolean      @default(false) @map("premium_only")
  imageUrl    String?      @map("image_url")
  emoji       String? // representación visual mientras no haya ilustraciones
  sortOrder   Int          @default(0) @map("sort_order")
  active      Boolean      @default(true)
  // Objetos exclusivos: no se compran, se ganan con rachas de actividades.
  purchasable Boolean      @default(true)
  unlockKey   String?      @map("unlock_key")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  owners UserItem[]

  @@map("items")
}

model UserItem {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  equipped   Boolean  @default(false) // ropa/accesorio puesto en el avatar
  growth     Int      @default(0) // riegos recibidos; las plantas crecen por etapas
  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz(6)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item             @relation(fields: [itemId], references: [id])
  placement GardenPlacement?

  @@unique([userId, itemId])
  @@map("user_items")
}

model GardenPlacement {
  id         String @id @default(uuid()) @db.Uuid
  userItemId String @unique @map("user_item_id") @db.Uuid // cada objeto ocupa un solo lugar
  x          Float
  y          Float
  rotation   Float  @default(0)
  layer      Int    @default(0)

  userItem UserItem @relation(fields: [userItemId], references: [id], onDelete: Cascade)

  @@map("garden_placements")
}

// Historial de semillas: positivo = ganadas, negativo = gastadas.
// profiles.seeds_balance debe actualizarse en la misma transacción.
model SeedTransaction {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  amount      Int
  reason      SeedReason
  referenceId String?    @map("reference_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("seed_transactions")
}

// ─────────────────────────────────────────────
// Retos
// ─────────────────────────────────────────────

model Challenge {
  id               String            @id @default(uuid()) @db.Uuid
  slug             String            @unique
  title            String
  description      String
  category         ChallengeCategory
  focusAreas       FocusArea[]       @map("focus_areas")
  evidenceType     EvidenceType      @map("evidence_type")
  reflectionPrompt String?           @map("reflection_prompt") // «¿Qué observaste en ti después de realizarlo?»
  seedsReward      Int               @map("seeds_reward")
  durationMinutes  Int?              @map("duration_minutes")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  assignments DailyChallenge[]

  @@map("challenges")
}

model DailyChallenge {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  challengeId  String               @map("challenge_id") @db.Uuid
  date         DateTime             @db.Date
  status       DailyChallengeStatus @default(PENDING)
  completedAt  DateTime?            @map("completed_at") @db.Timestamptz(6)
  seedsAwarded Int                  @default(0) @map("seeds_awarded")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge          @relation(fields: [challengeId], references: [id])
  evidence  ChallengeEvidence?

  @@unique([userId, challengeId, date])
  @@index([userId, date])
  @@map("daily_challenges")
}

model ChallengeEvidence {
  id               String       @id @default(uuid()) @db.Uuid
  dailyChallengeId String       @unique @map("daily_challenge_id") @db.Uuid
  type             EvidenceType
  textContent      String?      @map("text_content")
  mediaKey         String?      @map("media_key") // ruta del audio/foto en el almacenamiento privado
  mediaDurationSec Int?         @map("media_duration_sec")
  reflection       String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  dailyChallenge DailyChallenge @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)

  @@map("challenge_evidences")
}

// ─────────────────────────────────────────────
// Diario y registro emocional
// ─────────────────────────────────────────────

model JournalPrompt {
  id        String     @id @default(uuid()) @db.Uuid
  text      String
  focusArea FocusArea? @map("focus_area")
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  entries JournalEntry[]

  @@map("journal_prompts")
}

model JournalEntry {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  promptId         String?   @map("prompt_id") @db.Uuid
  title            String?
  contentEncrypted String    @map("content_encrypted") // cifrado en el backend antes de guardarse
  theme            String?
  pageColor        String?   @map("page_color")
  aiReflection     String?   @map("ai_reflection")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt JournalPrompt? @relation(fields: [promptId], references: [id])

  @@index([userId, createdAt])
  @@map("journal_entries")
}

model MoodLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  date            DateTime @db.Date
  emotion         Emotion? // registros anteriores a las emociones configurables
  emotionOptionId String?  @map("emotion_option_id") @db.Uuid
  // Copia de la emoción al registrarla: el calendario se ve igual aunque luego cambie o se borre.
  emotionLabel    String   @map("emotion_label")
  emotionEmoji    String   @map("emotion_emoji")
  emotionColor    String   @map("emotion_color")
  intensity       Int      @db.SmallInt // 1 a 5
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotionOption EmotionOption? @relation(fields: [emotionOptionId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("mood_logs")
}

// Emociones que la persona puede registrar. Sin psicólogo (psychologistId nulo) son la lista por defecto;
// cada psicólogo puede armar la suya para sus pacientes.
model EmotionOption {
  id             String   @id @default(uuid()) @db.Uuid
  psychologistId String?  @map("psychologist_id") @db.Uuid
  slug           String?  @unique // solo las de la lista por defecto
  label          String
  emoji          String
  color          String   @db.Char(7)
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  psychologist Psychologist? @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  moodLogs     MoodLog[]

  @@index([psychologistId, active])
  @@map("emotion_options")
}

// ─────────────────────────────────────────────
// Chat con IA (Groq) y seguridad
// ─────────────────────────────────────────────

model ChatConversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  mode      ChatMode  @default(SUPPORT)
  title     String?
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, startedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String     @id @default(uuid()) @db.Uuid
  conversationId String     @map("conversation_id") @db.Uuid
  role           ChatRole
  content        String
  model          String? // modelo de Groq que respondió
  tokensIn       Int?       @map("tokens_in")
  tokensOut      Int?       @map("tokens_out")
  riskLevel      RiskLevel? @map("risk_level")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// Contador diario para los límites del plan (p. ej. 10 gratis / 30 premium).
// Los mensajes en situación de riesgo no deben contar contra el límite.
model ChatUsage {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  date          DateTime @db.Date
  messagesCount Int      @default(0) @map("messages_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("chat_usage")
}

model RiskEvent {
  id                   String     @id @default(uuid()) @db.Uuid
  userId               String     @map("user_id") @db.Uuid
  source               RiskSource
  sourceId             String?    @map("source_id") @db.Uuid
  level                RiskLevel
  detector             String? // modelo/versión que lo detectó
  actionTaken          String?    @map("action_taken")
  crisisResourcesShown Boolean    @default(false) @map("crisis_resources_shown")
  reviewedAt           DateTime?  @map("reviewed_at") @db.Timestamptz(6)
  reviewedById         String?    @map("reviewed_by_id") @db.Uuid
  notes                String?
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User  @relation("RiskEventUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("RiskEventReviewer", fields: [reviewedById], references: [id])

  @@index([userId, createdAt])
  @@index([level, reviewedAt])
  @@map("risk_events")
}

model CrisisResource {
  id           String   @id @default(uuid()) @db.Uuid
  countryCode  String   @map("country_code") @db.Char(2)
  name         String
  phone        String?
  url          String?
  description  String?
  available24h Boolean  @default(false) @map("available_24h")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([countryCode, active])
  @@map("crisis_resources")
}

// ─────────────────────────────────────────────
// Plan personal de bienestar (también disponible sin conexión en la app)
// ─────────────────────────────────────────────

model WellbeingPlan {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  helpfulActivities String[] @map("helpful_activities")
  warningSigns      String[] @map("warning_signs")
  copingStrategies  String[] @map("coping_strategies")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts SupportContact[]

  @@map("wellbeing_plans")
}

model SupportContact {
  id           String  @id @default(uuid()) @db.Uuid
  planId       String  @map("plan_id") @db.Uuid
  name         String
  relationship String?
  phone        String?

  plan WellbeingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("support_contacts")
}

// ─────────────────────────────────────────────
// Comunidad
// ─────────────────────────────────────────────

model Room {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  icon        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  posts Post[]

  @@map("rooms")
}

model Post {
  id        String     @id @default(uuid()) @db.Uuid
  roomId    String     @map("room_id") @db.Uuid
  authorId  String     @map("author_id") @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid // respuestas
  content   String
  anonymous Boolean    @default(false)
  status    PostStatus @default(VISIBLE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  room      Room           @relation(fields: [roomId], references: [id])
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Post?          @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Post[]         @relation("PostReplies")
  reactions PostReaction[]
  reports   Report[]

  @@index([roomId, createdAt])
  @@index([parentId])
  @@map("posts")
}

model PostReaction {
  postId    String       @map("post_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_reactions")
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  postId       String       @map("post_id") @db.Uuid
  reason       ReportReason
  details      String?
  status       ReportStatus @default(OPEN)
  resolvedById String?      @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id])
  post       Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("reports")
}

// ─────────────────────────────────────────────
// Psicólogos y citas
// ─────────────────────────────────────────────

model Psychologist {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  fullName          String    @map("full_name")
  licenseNumber     String    @map("license_number")
  specialties       String[]
  bio               String?
  photoUrl          String?   @map("photo_url")
  sessionPriceCents Int       @map("session_price_cents")
  currency          String    @default("MXN") @db.Char(3)
  sessionMinutes    Int       @default(50) @map("session_minutes")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(6)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Código que el psicólogo comparte para que su paciente se vincule desde la app.
  linkCode          String    @unique @map("link_code")
  timezone          String    @default("America/Mexico_City")
  defaultMeetingUrl String?   @map("default_meeting_url")
  // Agenda pública: personas sin cuenta reservan desde el sitio web del psicólogo (p. ej. EspacioVital).
  publicSlug           String?  @unique @map("public_slug")
  publicBookingEnabled Boolean  @default(false) @map("public_booking_enabled")
  notifyPhone          String?  @map("notify_phone") // en formato E.164 (+50760000000): avisos por WhatsApp o SMS
  notifyWhatsappKey    String?  @map("notify_whatsapp_key") // clave de CallMeBot para avisarle por WhatsApp

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots              AvailabilitySlot[]
  appointments       Appointment[]
  sharedSummaries    SharedSummary[]
  careLinks          CareLink[]
  availabilityRules  AvailabilityRule[]
  availabilityBlocks AvailabilityBlock[]
  routines           Routine[]
  contents           AssignedContent[]
  emotionOptions     EmotionOption[]

  @@map("psychologists")
}

// Vínculo entre una persona y su psicólogo asignado. Solo puede haber uno activo por persona.
// Al vincularse, la persona acepta compartir el progreso de las rutinas que le asigne.
model CareLink {
  id                   String         @id @default(uuid()) @db.Uuid
  patientId            String         @map("patient_id") @db.Uuid
  psychologistId       String         @map("psychologist_id") @db.Uuid
  status               CareLinkStatus @default(ACTIVE)
  shareRoutineProgress Boolean        @default(true) @map("share_routine_progress")
  // Retos automáticos del catálogo por día; lo decide el psicólogo (0 = solo sus retos).
  autoChallengesPerDay Int            @default(3) @map("auto_challenges_per_day")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  endedAt              DateTime?      @map("ended_at") @db.Timestamptz(6)

  patient      User         @relation("PatientCareLinks", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@index([psychologistId, status])
  @@map("care_links")
}

// Horario semanal del psicólogo, en minutos desde la medianoche de su zona horaria.
model AvailabilityRule {
  id             String @id @default(uuid()) @db.Uuid
  psychologistId String @map("psychologist_id") @db.Uuid
  weekday        Int    @db.SmallInt // 0 = domingo … 6 = sábado
  startMinute    Int    @map("start_minute")
  endMinute      Int    @map("end_minute")

  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId])
  @@map("availability_rules")
}

// Días u horas en que el psicólogo no atiende (vacaciones, congresos…).
model AvailabilityBlock {
  id             String   @id @default(uuid()) @db.Uuid
  psychologistId String   @map("psychologist_id") @db.Uuid
  startsAt       DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(6)
  reason         String?

  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId, startsAt])
  @@map("availability_blocks")
}

// Actividad que un psicólogo asigna a su paciente para ciertos días de la semana.
model Routine {
  id               String       @id @default(uuid()) @db.Uuid
  psychologistId   String       @map("psychologist_id") @db.Uuid
  patientId        String       @map("patient_id") @db.Uuid
  title            String
  description      String
  evidenceType     EvidenceType @default(TEXT) @map("evidence_type")
  reflectionPrompt String?      @map("reflection_prompt")
  weekdays         Int[] // 0 = domingo … 6 = sábado
  startDate        DateTime     @map("start_date") @db.Date
  endDate          DateTime?    @map("end_date") @db.Date
  seedsReward      Int          @default(10) @map("seeds_reward")
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  psychologist Psychologist        @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  patient      User                @relation("PatientRoutines", fields: [patientId], references: [id], onDelete: Cascade)
  completions  RoutineCompletion[]

  @@index([patientId, active])
  @@index([psychologistId])
  @@map("routines")
}

model RoutineCompletion {
  id          String     @id @default(uuid()) @db.Uuid
  routineId   String     @map("routine_id") @db.Uuid
  date        DateTime   @db.Date
  textContent String?    @map("text_content")
  reflection  String?
  riskLevel   RiskLevel? @map("risk_level")
  completedAt DateTime   @default(now()) @map("completed_at") @db.Timestamptz(6)

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
  @@map("routine_completions")
}

model AvailabilitySlot {
  id             String     @id @default(uuid()) @db.Uuid
  psychologistId String     @map("psychologist_id") @db.Uuid
  startsAt       DateTime   @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime   @map("ends_at") @db.Timestamptz(6)
  status         SlotStatus @default(OPEN)

  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  appointment  Appointment?

  @@unique([psychologistId, startsAt])
  @@map("availability_slots")
}

model Appointment {
  id                   String              @id @default(uuid()) @db.Uuid
  // Nulo cuando la cita se reservó desde la web sin cuenta (los datos van en patient* y guest*).
  patientId            String?             @map("patient_id") @db.Uuid
  psychologistId       String              @map("psychologist_id") @db.Uuid
  slotId               String?             @unique @map("slot_id") @db.Uuid
  startsAt             DateTime            @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime            @map("ends_at") @db.Timestamptz(6)
  status               AppointmentStatus   @default(PENDING_PAYMENT)
  modality             AppointmentModality @default(VIDEO)
  meetingUrl           String?             @map("meeting_url")
  priceCents           Int                 @map("price_cents")
  currency             String              @db.Char(3)
  paymentRef           String?             @map("payment_ref") // id del pago en Stripe
  notesForPsychologist String?             @map("notes_for_psychologist") // motivo de la cita, escrito por la persona
  // Datos que la persona escribe al agendar; solo los ve su psicólogo.
  patientFullName      String?             @map("patient_full_name")
  patientIdNumber      String?             @map("patient_id_number") // cédula o documento de identidad
  patientBirthDate     DateTime?           @map("patient_birth_date") @db.Date
  cancelledAt          DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelReason         String?             @map("cancel_reason")
  cancelledBy          AppointmentCanceller? @map("cancelled_by")
  source               AppointmentSource   @default(APP)
  guestEmail           String?             @map("guest_email")
  guestPhone           String?             @map("guest_phone")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  patient      User?             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  psychologist Psychologist      @relation(fields: [psychologistId], references: [id])
  slot         AvailabilitySlot? @relation(fields: [slotId], references: [id])

  @@index([patientId, startsAt])
  @@index([psychologistId, startsAt])
  @@map("appointments")
}

// Resumen mensual que la persona decide compartir con su psicólogo.
// Los profesionales nunca tienen acceso automático al diario ni al chat.
model SharedSummary {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  psychologistId String?   @map("psychologist_id") @db.Uuid
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  content        Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  psychologist Psychologist? @relation(fields: [psychologistId], references: [id])

  @@index([userId])
  @@map("shared_summaries")
}

// ─────────────────────────────────────────────
// Actividades (además de los retos)
// ─────────────────────────────────────────────

// Cada vez que la persona hace una actividad. La gratitud se guarda cifrada.
model ActivityLog {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  type          ActivityType
  date          DateTime     @db.Date // día local de la persona
  durationSec   Int?         @map("duration_sec")
  dataEncrypted String?      @map("data_encrypted")
  contentId     String?      @map("content_id") @db.Uuid
  waterEarned   Int          @default(0) @map("water_earned")
  seedsEarned   Int          @default(0) @map("seeds_earned")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, date])
  @@map("activity_logs")
}

// Lecturas o enlaces que el psicólogo asigna a su paciente.
model AssignedContent {
  id             String      @id @default(uuid()) @db.Uuid
  psychologistId String      @map("psychologist_id") @db.Uuid
  patientId      String      @map("patient_id") @db.Uuid
  title          String
  kind           ContentKind
  body           String?
  url            String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(6)

  psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  patient      User         @relation("PatientContent", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, completedAt])
  @@map("assigned_content")
}
